# Optional: Require bearer token for /speak and /stop
KOKORO_API_TOKEN=replace-with-a-long-random-token

# Optional: Comma-separated CORS origins
# Example: chrome-extension://<your-extension-id>,http://127.0.0.1:8765
KOKORO_ALLOWED_ORIGINS=chrome-extension://*,http://localhost:*,http://127.0.0.1:*

# Optional safety limits
KOKORO_MAX_REQUEST_CHARS=200000
KOKORO_MAX_JSON_BODY_BYTES=250000

# Optional: expose internal status details at /health
# Keep false for public or shared environments
KOKORO_EXPOSE_DEBUG_STATUS=false
